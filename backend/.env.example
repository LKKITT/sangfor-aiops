# ========== LLM 配置（OpenAI 兼容协议，可切换厂商） ==========
# 智谱 GLM 示例:
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash
# DeepSeek 示例:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ========== 运行模式 ==========
# 只读模式: true 时 Agent 拒绝一切变更类操作
READONLY_MODE=false
# 每日自动备份时间（小时，0-23）
AUTO_BACKUP_HOUR=2
# 每日更新信息刷新时间（小时，0-23）
UPDATE_REFRESH_HOUR=3

# ========== 深信服技术支持平台（可选） ==========
# 平台正文需登录认证，可粘贴浏览器登录后的 Cookie 以抓取需认证内容；不配置则自动降级到公开源+内置知识库
SANGFOR_SUPPORT_COOKIE=

# ========== 设备连接超时 ==========
DEVICE_HTTP_TIMEOUT=10
