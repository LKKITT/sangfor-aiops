# ========== LLM 配置（OpenAI 兼容协议，可切换厂商） ==========
# 智谱 GLM 示例:
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash
# DeepSeek 示例:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
# 采样与思考参数按模型官方要求：temperature=1、top_p=0.95、reasoning_effort=max、
# thinking.type=enabled（仅支持 enabled，clear_thinking=false），流式工具调用 tool_stream=true
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_REASONING_EFFORT=max
LLM_TOOL_STREAM=true

# ========== 运行模式 ==========
# 只读模式: true 时 Agent 拒绝一切变更类操作
READONLY_MODE=false
# 每日自动备份时间（小时，0-23）
AUTO_BACKUP_HOUR=2
# 每日更新信息刷新时间（小时，0-23）
UPDATE_REFRESH_HOUR=3

# ========== 深信服技术支持平台（可选） ==========
# 平台正文需登录认证，可粘贴浏览器登录后的 Cookie 以抓取需认证内容；不配置则自动降级到公开源+内置知识库
SANGFOR_SUPPORT_COOKIE=

# ========== 设备连接超时 ==========
DEVICE_HTTP_TIMEOUT=10

# ========== 企业微信智能机器人渠道（可选，WebSocket 长连接） ==========
# 企微管理后台创建智能机器人并开启「API 模式-长连接」后，填入 BotID 与 Secret 即启用
WECOM_AIBOT_ENABLED=false
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
# 发送方白名单（逗号分隔企微 userid，留空=允许全部企微成员）
WECOM_ALLOWED_USERS=
# 渠道只读模式: true 时企微端不开放写操作确认（引导回 Web 界面），false 支持企微内确认执行
CHANNEL_READONLY_MODE=true
# 渠道会话超时（分钟）: 超过该时长未对话，下次消息自动开启新会话（0=关闭）
CHANNEL_SESSION_TIMEOUT_MINUTES=30
